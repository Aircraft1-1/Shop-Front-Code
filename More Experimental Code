def customer_submenu():
    print("\n---☆Меню для клиентов☆---")
    for i, item in enumerate(customer_menu, start = 1):
        print(f"{i}. {item.name} - ${item.price:,}")
            
    sales_tax = 0.07
        
        
        
    while True:
        choice = input("\nSelect items 1-8 or leave: ")
        if choice.isdigit() and 1 <= int(choice) <= len(customer_menu):
            index = int(choice) - 1
            selected = customer_menu[index]
            
            tax_amount = selected.price * sales_tax
            total_price = selected.price + tax_amount
            
            
            print(f"\nCustomer selected: {selected.name} for ${selected.price:,}")
            print("+++++++++++++++++++++++++++++++++++++++++")
            print("    RECIEPT    ")
            print("Date: 06/02/26")
            print("Sold: Buryatia StoreFronts")
            
            print(f"Sales Tax ({sales_tax * 100}%): ${tax_amount:,.2f}")
            print(f"Total: ${total_price:,.2f}")
            print(f"\nSignature:x___________________")
            print("+++++++++++++++++++++++++++++++++++++++++")
            
            
        elif choice.lower() == 'leave':

            print("Returning...")

            break
            
            
            
        else:
            print("ⓘINVALIDⓘ")
        
