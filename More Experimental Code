def owner_submenu():
    while True:
        print("\n---☆Меню владельца☆---")
        for i, item in enumerate(owner_menu, start = 1):
            print(f"{i}. {item.name} |?| Stock: {item.supply} |?| Price: ${item.price:,}")
    
        print(f"\n{len(owner_menu) + 1}. ➕ Add a new item?")
        choice = input(f"\nSelect items 1-{len(owner_menu) + 1} or type 'return': ")
    
        if choice.isdigit():
            choice_num = int(choice)
        
            if choice_num == len(owner_menu) + 1:
                name = input("Enter item name: ")
                price = int(input("Enter item price: "))
                supply = int(input("Enter intial supply: "))
            
                customer_menu.append(Мәзір_элементтері_custo(name, price))
                owner_menu.append(Мәзір_элементтері_owner(name, price, supply))
                print(f"✔️ {name} added!")
        
            else:
                print("ⓘINVALIDⓘ")
   
        elif choice.lower() == 'return':
        
            print("Returning...")
        
        
    
    else:
        print("ⓘINVALIDⓘ")
    
    while True:
